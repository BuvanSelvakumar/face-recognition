# Copy this file to .env and fill it in.

# The address guests open (goes inside the QR code). No trailing slash.
#   laptop test:        http://localhost:8000
#   Cloudflare tunnel:  https://your-tunnel.trycloudflare.com
#   Oracle Cloud:       https://photos.yourstudio.com
PUBLIC_BASE_URL=http://localhost:8000

# Admin login for /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Google service-account key file (see README → Google Drive setup)
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json

# Allow "Folder on this computer" events (set false on a cloud server)
ALLOW_LOCAL_FOLDERS=true

# Face matching. Raise MATCH_THRESHOLD (e.g. 0.65) if guests see other people's photos;
# lower it (e.g. 0.55) if guests miss their own. Tune with: python -m app.cli match <slug> selfie.jpg
MATCH_THRESHOLD=0.60
# yunet = fast (~0.2s/photo on a laptop). retinaface = slower (~5s/photo), sometimes finds more tiny/side faces
FACE_DETECTOR=yunet
MIN_FACE_PX=40

# Days before an event's face data + thumbnails are auto-deleted
DEFAULT_EVENT_DAYS=60
GUEST_SESSION_DAYS=30
